# Required: existing Neon runtime database with SSL. No local fallback.
POSTGRES_URL=

# Shared server-only secret for the website and Go judge (at least 32 characters).
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JUDGE_TOKEN=

# The judge's HTTPS address; see "Judge VM" in README.md. http:// works only for this
# machine, for example through an SSH tunnel to the VM.
JUDGE_URL=
