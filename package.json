{
  "name": "coding-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server/start.mjs",
    "start": "node server/start.mjs --preview",
    "build": "tsc --noEmit && vite build",
    "runner:setup": "node runner/setup.mjs",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:db": "node tests/run-database.mjs",
    "test:execution": "node --test tests/runner/execution.test.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "format": "prettier --write \"{src,server,runner,tests}/**/*.{ts,tsx,js,mjs,css}\" \"*.ts\" index.html package.json tsconfig.json",
    "format:check": "prettier --check \"{src,server,runner,tests}/**/*.{ts,tsx,js,mjs,css}\" \"*.ts\" index.html package.json tsconfig.json",
    "check": "npm run format:check && npm run build && npm test && npm run test:execution && npm run test:db && npm run test:e2e"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@fontsource/geist": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "4.25.11",
    "express": "5.2.1",
    "lucide-react": "1.42.0",
    "pg": "^8.23.0",
    "pyodide": "314.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "off"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
