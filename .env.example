# Required: existing Neon runtime database with SSL. No local fallback.
POSTGRES_URL=

# Shared server-only secret for the website and Go judge (32–256 ASCII characters).
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JUDGE_TOKEN=

# Existing persistent Vercel Sandbox shared by both websites.
JUDGE_SANDBOX_NAME=corecode-judge
