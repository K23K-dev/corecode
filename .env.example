# Required: existing Neon runtime database with SSL. No local fallback.
# Copy its connection string into private .env; never use a VITE_ prefix.
POSTGRES_URL=

# Required only for database/browser tests: a separately authorized Neon test
# branch/database, using a direct (non-pooler) connection with sslmode=require.
# Never use the runtime database, even via its direct connection. No auto-provisioning.
# TEST_POSTGRES_URL=
