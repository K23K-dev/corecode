# Required: existing Neon runtime database with SSL. No local fallback.
# Copy its connection string into private .env; never use a VITE_ prefix.
POSTGRES_URL=

# Vercel Production only. Set to 1 AFTER enabling Vercel Authentication for
# All Deployments. This acknowledgement does not provide authentication itself.
# VERCEL_AUTHENTICATION_CONFIRMED=1

# Optional canonical production origin; otherwise Vercel's production URL is used.
# APP_ORIGIN=https://corecode-omega.vercel.app

# Set only after preparing and verifying the hosted runner's clean snapshot.
# RUNNER_SANDBOX_SNAPSHOT=snap_...

# Required only for database/browser tests: a separately authorized Neon test
# branch/database, using a direct (non-pooler) connection with sslmode=require.
# Never use the runtime database, even via its direct connection. No auto-provisioning.
# TEST_POSTGRES_URL=
