{
  "name": "coding-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "judge:images": "node judge/build-images.mjs",
    "judge:dev": "node judge/tool.mjs dev",
    "judge:build": "node judge/tool.mjs build",
    "judge:check": "node judge/tool.mjs check",
    "judge:generate": "node judge/tool.mjs generate",
    "format": "prettier --write \"{src,judge}/**/*.{ts,mts,tsx,js,mjs,css}\" next.config.ts package.json tsconfig.json vercel.json",
    "format:check": "prettier --check \"{src,judge}/**/*.{ts,mts,tsx,js,mjs,css}\" next.config.ts package.json tsconfig.json vercel.json",
    "check": "npm run format:check && npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "2.2.0",
    "@fontsource/geist": "5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@uiw/react-codemirror": "4.25.11",
    "@vercel/functions": "3.9.7",
    "@vercel/sandbox": "3.3.0",
    "esbuild": "0.27.0",
    "lucide-react": "1.42.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf",
    "embeddedLanguageFormatting": "off"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
