# Required: existing Neon runtime database with SSL. No local fallback.
POSTGRES_URL=

# Shared server-only secret for the website and Go judge (32–256 ASCII characters).
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JUDGE_TOKEN=

# Existing persistent Vercel Sandbox shared by both websites.
JUDGE_SANDBOX_NAME=corecode-judge

# Local Sandbox access: link the existing Vercel project and pull .env.local
# for project-scoped OIDC. Production receives OIDC automatically.
# Explicit credentials can instead use VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID.

# A separate local judge can use this instead of JUDGE_SANDBOX_NAME.
# JUDGE_ADDRESS=127.0.0.1:50051

# Optional direct SSL connection to an authorized, isolated Neon test branch.
# TEST_POSTGRES_URL=

# Optional Go judge overrides (defaults shown).
# JUDGE_PYTHON_IMAGE=cp-practice-python:2
# JUDGE_JAVASCRIPT_IMAGE=coding-practice-js:2
# DOCKER_HOST can override the local Docker socket/Windows named pipe.
